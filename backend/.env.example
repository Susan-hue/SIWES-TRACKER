# Follow-up drafts (the only feature that costs money per call).
# Provider is detected from the key: gsk_ = Groq, xai- = xAI Grok, sk-ant- = Anthropic Claude.
LLM_API_KEY=
# LLM_PROVIDER=groq        # only needed to override detection
# LLM_MODEL=               # defaults: groq openai/gpt-oss-120b, xai grok-4, anthropic claude-opus-5
FOLLOWUP_AFTER_DAYS=7

# Web Push: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:amechi4emma@gmail.com

# Shared with the daily scheduler (GitHub Actions secret of the same name)
CRON_SECRET=
